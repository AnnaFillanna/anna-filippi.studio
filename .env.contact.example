# Nur serverseitig in Vercel konfigurieren; keine VITE_-Präfixe verwenden.
CONTACT_ENABLED=false
CONTACT_ALLOWED_ORIGINS=https://annafilippi.studio
CONTACT_EMAIL_TO=annafilippi@web.de
# Absenderadresse einer eigenen, bei Resend verifizierten Domain:
CONTACT_EMAIL_FROM=
# Alternativ werden die bisherigen Namen CONTACT_TO und CONTACT_FROM unterstützt.
RESEND_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Zufälliges Geheimnis mit mindestens 32 Zeichen:
RATE_LIMIT_SECRET=

# Nur für serverseitige Supabase-Speicherung, niemals mit VITE_-Präfix.
SUPABASE_SECRET_KEY=
# Optional; sonst wird die vorhandene VITE_SUPABASE_URL verwendet.
SUPABASE_URL=
