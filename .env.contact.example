# Server only. Copy values to Vercel Environment Variables; never use VITE_ prefixes.
CONTACT_ENABLED=false
CONTACT_ALLOWED_ORIGINS=https://annafilippi.studio
CONTACT_TO=annafilippi@web.de
# A sender address on a domain you own AND have verified in Resend:
CONTACT_FROM=
RESEND_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random secret, at least 32 characters:
RATE_LIMIT_SECRET=

# Server-side Supabase ingestion only. Never prefix the secret with VITE_.
SUPABASE_SECRET_KEY=
# Optional override; otherwise the server uses existing VITE_SUPABASE_URL.
SUPABASE_URL=
